    entity_name "&#1043;&#1077;&#1085;&#1088;&#1080;&#1082; &#1040;&#1076;&#1072;&#1084; &#1040;&#1083;&#1077;&#1082;&#1089;&#1072;&#1085;&#1076;&#1088; &#1055;&#1080;&#1081; &#1057;&#1077;&#1085;&#1082;&#1077;&#1074;&#1080;&#1095;"
    entity_type "PERSON"
    description "&#1055;&#1086;&#1083;&#1100;&#1089;&#1082;&#1080;&#1081; &#1087;&#1080;&#1089;&#1072;&#1090;&#1077;&#1083;&#1100; (&#1072;&#1074;&#1090;&#1086;&#1088; &#1080;&#1089;&#1090;&#1086;&#1088;&#1080;&#1095;&#1077;&#1089;&#1082;&#1080;&#1093; &#1088;&#1086;&#1084;&#1072;&#1085;&#1086;&#1074;), &#1087;&#1086;&#1083;&#1085;&#1086;&#1077; &#1080;&#1084;&#1103; &#8212; Henryk Adam Aleksander Pius Sienkiewicz; &#1090;&#1072;&#1082;&#1078;&#1077; &#1091;&#1087;&#1086;&#1084;&#1080;&#1085;&#1072;&#1077;&#1090;&#1089;&#1103; &#1082;&#1072;&#1082; &#1043;&#1077;&#1085;&#1088;&#1080;&#1093; (&#1043;&#1077;&#1085;&#1088;&#1080;&#1082;) &#1048;&#1086;&#1089;&#1080;&#1092;&#1086;&#1074;&#1080;&#1095; &#1057;&#1077;&#1085;&#1082;&#1077;&#1074;&#1080;&#1095;. &#1056;&#1086;&#1076;&#1080;&#1083;&#1089;&#1103; 5 &#1084;&#1072;&#1103; 1846 &#1075;&#1086;&#1076;&#1072; &#1074; &#1042;&#1086;&#1083;e-&#1054;&#1082;&#1096;&#1077;&#1081;&#1089;&#1082;&#1086;&#1081; &#1085;&#1072; &#1055;&#1086;&#1076;&#1083;&#1103;&#1096;&#1100;&#1077; (&#1062;&#1072;&#1088;&#1089;&#1090;&#1074;&#1086; &#1055;&#1086;&#1083;&#1100;&#1089;&#1082;&#1086;&#1077; &#1074; &#1089;&#1086;&#1089;&#1090;&#1072;&#1074;&#1077; &#1056;&#1086;&#1089;&#1089;&#1080;&#1081;&#1089;&#1082;&#1086;&#1081; &#1080;&#1084;&#1087;&#1077;&#1088;&#1080;&#1080;) &#1080; &#1091;&#1084;&#1077;&#1088; 15 &#1085;&#1086;&#1103;&#1073;&#1088;&#1103; 1916 &#1075;&#1086;&#1076;&#1072; &#1074; &#1075;&#1086;&#1088;&#1086;&#1076;&#1077; &#1042;&#1077;&#1074;&#1077; (&#1064;&#1074;&#1077;&#1081;&#1094;&#1072;&#1088;&#1080;&#1103;). &#1051;&#1072;&#1091;&#1088;&#1077;&#1072;&#1090; &#1053;&#1086;&#1073;&#1077;&#1083;&#1077;&#1074;&#1089;&#1082;&#1086;&#1081; &#1087;&#1088;&#1077;&#1084;&#1080;&#1080; &#1087;&#1086; &#1083;&#1080;&#1090;&#1077;&#1088;&#1072;&#1090;&#1091;&#1088;&#1077; 1905 &#1075;&#1086;&#1076;&#1072;. &#1053;&#1072;&#1088;&#1103;&#1076;&#1091; &#1089; &#1069;&#1083;&#1080;&#1079;&#1086;&#1081; &#1054;&#1078;&#1077;&#1096;&#1082;&#1086; &#1080; &#1041;&#1086;&#1083;&#1077;&#1089;&#1083;&#1072;&#1074;&#1086;&#1084; &#1055;&#1088;&#1091;&#1089;&#1086;&#1084; &#1087;&#1088;&#1080;&#1085;&#1072;&#1076;&#1083;&#1077;&#1078;&#1072;&#1083; &#1082; &#1087;&#1083;&#1077;&#1103;&#1076;&#1077; &#1074;&#1099;&#1076;&#1072;&#1102;&#1097;&#1080;&#1093;&#1089;&#1103; &#1087;&#1086;&#1083;&#1100;&#1089;&#1082;&#1080;&#1093; &#1088;&#1077;&#1072;&#1083;&#1080;&#1089;&#1090;&#1086;&#1074; XIX &#1074;&#1077;&#1082;&#1072;. &#1057; 1896 &#1075;&#1086;&#1076;&#1072; &#8212; &#1095;&#1083;&#1077;&#1085;-&#1082;&#1086;&#1088;&#1088;&#1077;&#1089;&#1087;&#1086;&#1085;&#1076;&#1077;&#1085;&#1090;, &#1089; 1914 &#1075;&#1086;&#1076;&#1072; &#8212; &#1087;&#1086;&#1095;&#1105;&#1090;&#1085;&#1099;&#1081; &#1072;&#1082;&#1072;&#1076;&#1077;&#1084;&#1080;&#1082; &#1048;&#1084;&#1087;&#1077;&#1088;&#1072;&#1090;&#1086;&#1088;&#1089;&#1082;&#1086;&#1081; &#1057;&#1072;&#1085;&#1082;&#1090;-&#1055;&#1077;&#1090;&#1077;&#1088;&#1073;&#1091;&#1088;&#1075;&#1089;&#1082;&#1086;&#1081; &#1072;&#1082;&#1072;&#1076;&#1077;&#1084;&#1080;&#1080; &#1085;&#1072;&#1091;&#1082; (&#1087;&#1086; &#1086;&#1090;&#1076;&#1077;&#1083;&#1077;&#1085;&#1080;&#1102; &#1088;&#1091;&#1089;&#1089;&#1082;&#1086;&#1075;&#1086; &#1103;&#1079;&#1099;&#1082;&#1072; &#1080; &#1089;&#1083;&#1086;&#1074;&#1077;&#1089;&#1085;&#1086;&#1089;&#1090;&#1080;). &#1053;&#1072;&#1080;&#1073;&#1086;&#1083;&#1077;&#1077; &#1080;&#1079;&#1074;&#1077;&#1089;&#1090;&#1085;&#1099;&#1077; &#1087;&#1088;&#1086;&#1080;&#1079;&#1074;&#1077;&#1076;&#1077;&#1085;&#1080;&#1103;: &#1080;&#1089;&#1090;&#1086;&#1088;&#1080;&#1095;&#1077;&#1089;&#1082;&#1072;&#1103; &#1090;&#1088;&#1080;&#1083;&#1086;&#1075;&#1080;&#1103; &#1086; &#1055;&#1086;&#1083;&#1100;&#1096;&#1077; XVII &#1074;&#1077;&#1082;&#1072;, &#1088;&#1086;&#1084;&#1072;&#1085; &#171;Quo vadis&#187; &#1086; &#1088;&#1072;&#1085;&#1085;&#1080;&#1093; &#1093;&#1088;&#1080;&#1089;&#1090;&#1080;&#1072;&#1085;&#1072;&#1093; &#1080; &#1088;&#1086;&#1084;&#1072;&#1085; &#171;&#1050;&#1088;&#1077;&#1089;&#1090;&#1086;&#1085;&#1086;&#1089;&#1094;&#1099;&#187; &#1086; &#1043;&#1088;&#1102;&#1085;&#1074;&#1072;&#1083;&#1100;&#1076;&#1089;&#1082;&#1086;&#1081; &#1073;&#1080;&#1090;&#1074;&#1077;; &#1101;&#1090;&#1080; &#1082;&#1085;&#1080;&#1075;&#1080; &#1074;&#1086;&#1089;&#1090;&#1086;&#1088;&#1078;&#1077;&#1085;&#1085;&#1086; &#1087;&#1088;&#1080;&#1085;&#1103;&#1090;&#1099; &#1087;&#1086;&#1083;&#1100;&#1089;&#1082;&#1086;&#1081; &#1087;&#1091;&#1073;&#1083;&#1080;&#1082;&#1086;&#1081;, &#1089;&#1090;&#1072;&#1083;&#1080; &#1095;&#1072;&#1089;&#1090;&#1100;&#1102; &#1085;&#1072;&#1094;&#1080;&#1086;&#1085;&#1072;&#1083;&#1100;&#1085;&#1086;&#1081; &#1082;&#1083;&#1072;&#1089;&#1089;&#1080;&#1082;&#1080; &#1080; &#1087;&#1086;&#1083;&#1091;&#1095;&#1080;&#1083;&#1080; &#1096;&#1080;&#1088;&#1086;&#1082;&#1091;&#1102; &#1080;&#1079;&#1074;&#1077;&#1089;&#1090;&#1085;&#1086;&#1089;&#1090;&#1100; &#1079;&#1072; &#1087;&#1088;&#1077;&#1076;&#1077;&#1083;&#1072;&#1084;&#1080; &#1055;&#1086;&#1083;&#1100;&#1096;&#1080;."
